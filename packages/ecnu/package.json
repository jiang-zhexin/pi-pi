{
  "name": "@zhexin/pi-ecnu",
  "description": "ECNU Chat provider for the Pi agent.",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "ecnu",
    "image-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiang-zhexin/pi-pi.git",
    "directory": "packages/ecnu"
  },
  "homepage": "https://github.com/jiang-zhexin/pi-pi/tree/HEAD/packages/ecnu#readme",
  "bugs": {
    "url": "https://github.com/jiang-zhexin/pi-pi/issues"
  },
  "files": [
    "src/*",
    "index.ts"
  ],
  "publishConfig": {
    "access": "public",
